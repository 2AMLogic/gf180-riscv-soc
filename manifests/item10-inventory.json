{
  "schema_version": 1,
  "kind": "t1-attestation-inventory",
  "t1_item": 10,
  "description": "README, LICENSE and CI exist, and the PDK-free CI gates still pass. The checks mirror the PDK-free commands of .github/workflows/verification.yml's stamped and lint jobs; lint_rtl.sh needs Verilator and is local-only, and the cocotb smoke job needs cocotb and iverilog and is not attested.",
  "hygiene": [
    "README.md",
    "LICENSE",
    ".github/workflows/verification.yml",
    ".github/workflows/signoff.yml"
  ],
  "checks": [
    {
      "name": "stamped-file-hashes",
      "argv": [
        "python3",
        "-I",
        "verification/tools/check_stamped.py"
      ]
    },
    {
      "name": "lint-records",
      "argv": [
        "python3",
        "-I",
        "verification/tools/lint_records.py"
      ]
    },
    {
      "name": "lint-records-tests",
      "argv": [
        "python3",
        "-I",
        "verification/tools/tests/test_lint_records.py"
      ]
    },
    {
      "name": "check-stamped-tests",
      "argv": [
        "python3",
        "-I",
        "verification/tools/tests/test_check_stamped.py"
      ]
    },
    {
      "name": "lint-rtl-tests",
      "argv": [
        "python3",
        "-I",
        "verification/tools/tests/test_lint_rtl.py"
      ]
    },
    {
      "name": "lint-rtl",
      "argv": [
        "verification/tools/lint_rtl.sh"
      ],
      "local_only": true
    }
  ]
}
